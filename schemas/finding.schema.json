{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/aicte/schemas/finding.schema.json",
  "title": "AICTE Validation Finding",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "finding_id",
    "application_id",
    "finding_type",
    "status",
    "severity",
    "title",
    "explanation",
    "created_at",
    "advisory_only"
  ],
  "properties": {
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "application_id": {
      "type": "string",
      "minLength": 1
    },
    "finding_type": {
      "type": "string",
      "enum": [
        "MISSING_EVIDENCE",
        "FIELD_MISMATCH",
        "RULE_RESULT",
        "EXPIRY",
        "DUPLICATE_CANDIDATE",
        "CROSS_YEAR_CHANGE",
        "INFRASTRUCTURE_SIGNAL",
        "SOURCE_VERIFICATION",
        "RELATIONSHIP_CANDIDATE",
        "PROCESSING_ERROR"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "OPEN",
        "ACKNOWLEDGED",
        "RESOLVED",
        "DISMISSED",
        "DEFERRED",
        "ESCALATED"
      ]
    },
    "severity": {
      "type": "string",
      "enum": [
        "INFO",
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "observed_values": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "expected_condition": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rule_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "rule_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missing_evidence_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_next_action": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "advisory_only": {
      "const": true
    },
    "demo_only": {
      "type": "boolean",
      "default": false
    }
  }
}
